<!doctype html>
<html lang="en" data-theme="light">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }} — sushen.dev</title>
  <script src="/support.js"></script>
</head>
<body>
<div class="reading-progress" aria-hidden="true"></div>
<x-dc>
<helmet><script src="/ds-base.js"></script><style>
  html,body{margin:0} a{color:var(--text-link);text-decoration:none}
  .note-shell{width:min(100%,1360px);margin:0 auto;padding:var(--space-8) clamp(20px,4vw,64px) var(--space-10)}
  .note-back{font:700 var(--text-xs)/1 var(--font-ui);letter-spacing:var(--track-label);text-transform:uppercase}
  .note-article{max-width:72ch;margin:var(--space-8) auto 0}
  .note-article h1{font:700 clamp(38px,6vw,66px)/1.05 var(--font-display);letter-spacing:var(--track-display);margin:var(--space-4) 0}
  .note-meta{font:var(--text-xs)/var(--lh-xs) var(--font-mono);color:var(--text-muted)}
  .note-source{display:inline-flex;margin-top:var(--space-7);font:700 var(--text-xs)/var(--lh-xs) var(--font-ui);letter-spacing:var(--track-label);text-transform:uppercase}
  .note-body{font:var(--text-md)/var(--lh-md) var(--font-body);color:var(--text-secondary);margin-top:var(--space-7)}
  .note-body h2{font-family:var(--font-display);color:var(--text-primary);margin-top:var(--space-8)}
  .note-body img{display:block;width:100%;height:auto;margin:var(--space-7) 0;border:1px solid var(--border-hairline)}
  .note-body :not(pre)>code{padding:2px 6px;border:1px solid var(--border-hairline);background:var(--surface-inset);color:var(--text-primary);border-radius:var(--radius-xs)}
  .note-body pre{position:relative;margin:var(--space-6) 0;padding:var(--space-5);overflow:auto;border:1px solid var(--border-hairline);background:var(--surface-inset);box-shadow:inset 3px 0 0 var(--accent-3)}
  .note-body pre code{font:var(--text-sm)/var(--lh-sm) var(--font-mono);color:var(--text-primary)}
  .copy-code{position:absolute;top:8px;right:8px;padding:5px 8px;border:1px solid var(--border-hairline);background:var(--bg-raised);color:var(--text-muted);font:700 var(--text-2xs)/1 var(--font-ui);letter-spacing:var(--track-label);text-transform:uppercase;cursor:pointer}
  .copy-code:hover{color:var(--accent);border-color:var(--accent)}
  .reading-progress{position:fixed;z-index:20;left:0;top:0;width:100%;height:2px;transform-origin:left;transform:scaleX(0);background:linear-gradient(90deg,var(--accent),var(--accent-3));box-shadow:0 0 12px var(--accent)}
  @media(prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important}}
</style></helmet>
<x-import component-from-global-scope="SushenDevDesignSystem_801d0d.GrainField" min-height="100vh" hint-size="100%,100vh">
  <main class="note-shell">
    <a class="note-back" href="/#learning">← field notes</a>
    <article class="note-article">
      <div class="note-meta">{{ date | htmlDate }} · {{ readingTime or "note" }}</div>
      <h1>{{ title }}</h1>
      {% if summary %}<p style="font:var(--text-lg)/var(--lh-lg) var(--font-body);color:var(--text-secondary)">{{ summary }}</p>{% endif %}
      <div class="note-body">{{ content | safe }}</div>
      {% if sourceUrl %}<a class="note-source" href="{{ sourceUrl }}" target="_blank" rel="noopener noreferrer">View original LinkedIn post ↗</a>{% endif %}
    </article>
  </main>
</x-import>
</x-dc>
<script type="text/x-dc" data-dc-script>
class Component extends DCLogic { renderVals() { return {}; } }
</script>
<script>
(() => {
  const enhance = () => document.querySelectorAll('.note-body pre:not([data-enhanced])').forEach((pre) => {
    pre.dataset.enhanced = 'true';
    const button = document.createElement('button');
    button.className = 'copy-code'; button.type = 'button'; button.textContent = 'copy';
    button.addEventListener('click', async () => {
      await navigator.clipboard.writeText(pre.querySelector('code')?.innerText || pre.innerText);
      button.textContent = 'copied'; setTimeout(() => button.textContent = 'copy', 1400);
    });
    pre.appendChild(button);
  });
  new MutationObserver(enhance).observe(document.body, {childList:true, subtree:true}); enhance();
  const progress = document.querySelector('.reading-progress');
  addEventListener('scroll', () => {
    const max = document.documentElement.scrollHeight - innerHeight;
    progress.style.transform = `scaleX(${max > 0 ? scrollY / max : 0})`;
  }, {passive:true});
})();
</script>
</body>
</html>
