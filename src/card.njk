<!doctype html>
<html lang="en" data-theme="light">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="#f3e8d2">
  <title>Sushen Yadav — contact card</title>
  <meta name="description" content="The digital contact card of Sushen Yadav, software engineer in Mumbai, India.">
  <script src="/support.js"></script>
  <script src="/ds-base.js"></script>
  <style>
    *{box-sizing:border-box}
    :root{color-scheme:light}
    html,body{margin:0;min-height:100%;background:#f3e8d2;color:#14171c}
    body{min-height:100svh;display:grid;place-items:center;padding:clamp(18px,5vw,64px);font-family:var(--font-ui,system-ui,sans-serif);overflow-x:hidden}
    body::before{content:"";position:fixed;inset:0;pointer-events:none;background:radial-gradient(circle at 18% 12%,rgb(255 255 255/.78),transparent 32%),radial-gradient(circle at 82% 84%,rgb(143 230 216/.24),transparent 34%);opacity:.9}
    .card-page{position:relative;width:min(100%,980px);display:grid;gap:18px;justify-items:center}
    .utility{width:min(100%,860px);display:flex;justify-content:space-between;align-items:center;font:700 13px/1 var(--font-ui,system-ui);letter-spacing:.12em;text-transform:uppercase}
    .utility a{color:#55534b;text-decoration:none;padding:10px 0}.utility a:hover{color:#14171c}
    .collectible{isolation:isolate;position:relative;width:min(100%,860px);aspect-ratio:1.586/1;min-height:430px;overflow:hidden;border:1px solid rgb(20 23 28/.28);border-radius:22px;background:linear-gradient(145deg,rgb(255 253 246/.96),rgb(243 232 210/.93));box-shadow:0 30px 80px rgb(20 23 28/.18),inset 0 1px rgb(255 255 255/.9)}
    .collectible::before{content:"";position:absolute;z-index:-2;inset:-55%;background:conic-gradient(from 120deg,transparent 0 30%,rgb(143 230 216/.32),rgb(255 194 77/.28),rgb(207 178 255/.25),transparent 66%);animation:foil 18s linear infinite}
    .collectible::after{content:"";position:absolute;z-index:-1;inset:1px;border-radius:21px;background:linear-gradient(145deg,rgb(255 253 246/.94),rgb(243 232 210/.86));backdrop-filter:blur(22px)}
    .card-grid{height:100%;padding:clamp(26px,5vw,58px);display:grid;grid-template-columns:1fr minmax(220px,.72fr);gap:clamp(26px,5vw,70px)}
    .identity{display:flex;min-width:0;flex-direction:column;justify-content:space-between}
    .eyebrow,.serial{font:700 clamp(11px,1.3vw,14px)/1.2 var(--font-mono,monospace);letter-spacing:.16em;text-transform:uppercase;color:#55534b}
    h1{margin:20px 0 10px;font:700 clamp(48px,8.5vw,96px)/.86 var(--font-display,monospace);letter-spacing:-.07em;color:#14171c}
    .role{margin:0;max-width:28ch;font:400 clamp(18px,2.3vw,27px)/1.35 var(--font-body,serif);color:#55534b}
    .location{display:flex;align-items:center;gap:9px;margin-top:24px;font:700 13px/1.2 var(--font-ui,system-ui);letter-spacing:.1em;text-transform:uppercase;color:#55534b}
    .live-dot{width:8px;height:8px;border-radius:50%;background:#16866f;box-shadow:0 0 0 0 rgb(22 134 111/.4);animation:pulse 2.4s ease-out infinite}
    .domain{font:700 clamp(21px,3vw,34px)/1 var(--font-display,monospace);letter-spacing:-.04em}.domain span{color:#c97a0a}
    .links{display:flex;flex-direction:column;justify-content:center;gap:10px}
    .contact-link{position:relative;display:grid;grid-template-columns:42px 1fr auto;align-items:center;gap:12px;min-height:64px;padding:10px 14px;border:1px solid rgb(20 23 28/.18);border-radius:12px;background:rgb(255 255 255/.36);color:#14171c;text-decoration:none;transition:transform 180ms ease,border-color 180ms ease,background 180ms ease}
    .contact-link:hover{transform:translateX(-5px);border-color:#c97a0a;background:rgb(255 253 246/.78)}
    .contact-link:focus-visible{outline:3px solid #ffc24d;outline-offset:3px}
    .icon{width:40px;height:40px;display:grid;place-items:center;border-radius:50%;background:#14171c;color:#fffdf6;font:700 15px/1 var(--font-mono,monospace)}
    .link-copy{min-width:0}.link-copy strong{display:block;font:700 15px/1.1 var(--font-ui,system-ui)}.link-copy small{display:block;margin-top:5px;overflow:hidden;text-overflow:ellipsis;font:12px/1 var(--font-mono,monospace);color:#55534b;white-space:nowrap}
    .arrow{font-size:20px;color:#8c8a80}
    .card-note{max-width:58ch;margin:0;text-align:center;font:14px/1.5 var(--font-ui,system-ui);color:#55534b}
    @keyframes foil{to{transform:rotate(1turn)}}
    @keyframes pulse{60%{box-shadow:0 0 0 8px rgb(22 134 111/0)}}
    @media(max-width:680px){body{place-items:start center}.collectible{aspect-ratio:auto;min-height:0}.card-grid{grid-template-columns:1fr;gap:36px}.identity{gap:42px}h1{font-size:clamp(52px,19vw,82px)}.contact-link:hover{transform:none}}
    @media(prefers-reduced-motion:reduce){.collectible::before,.live-dot{animation:none}.contact-link{transition:none}}
  </style>
</head>
<body>
  <main class="card-page">
    <nav class="utility" aria-label="Card navigation">
      <a href="/">← sushen.dev</a>
      <span class="serial">SY · 001 / MUM</span>
    </nav>

    <article class="collectible" aria-labelledby="card-name">
      <div class="card-grid">
        <section class="identity">
          <div>
            <p class="eyebrow">Software engineer · personal card</p>
            <h1 id="card-name">Sushen<br>Yadav</h1>
            <p class="role">Building useful software from research, systems thinking and applied AI.</p>
            <p class="location"><span class="live-dot" aria-hidden="true"></span>Mumbai, India</p>
          </div>
          <div class="domain">sushen<span>.dev</span></div>
        </section>

        <section class="links" aria-label="Contact links">
          <a class="contact-link" href="https://www.linkedin.com/in/sushenyadav" target="_blank" rel="me noreferrer">
            <span class="icon" aria-hidden="true">in</span><span class="link-copy"><strong>LinkedIn</strong><small>/in/sushenyadav</small></span><span class="arrow" aria-hidden="true">↗</span>
          </a>
          <a class="contact-link" href="https://github.com/Tsomoriri" target="_blank" rel="me noreferrer">
            <span class="icon" aria-hidden="true">GH</span><span class="link-copy"><strong>GitHub</strong><small>@Tsomoriri</small></span><span class="arrow" aria-hidden="true">↗</span>
          </a>
          <a class="contact-link" href="https://leetcode.com/u/sushenyadav/" target="_blank" rel="me noreferrer">
            <span class="icon" aria-hidden="true">LC</span><span class="link-copy"><strong>LeetCode</strong><small>@sushenyadav</small></span><span class="arrow" aria-hidden="true">↗</span>
          </a>
          <a class="contact-link" href="mailto:me@sushen.dev">
            <span class="icon" aria-hidden="true">@</span><span class="link-copy"><strong>Email</strong><small>me@sushen.dev</small></span><span class="arrow" aria-hidden="true">→</span>
          </a>
        </section>
      </div>
    </article>
    <p class="card-note">Tap a profile to connect. This card lives permanently at <strong>sushen.dev/card</strong>.</p>
  </main>
</body>
</html>
